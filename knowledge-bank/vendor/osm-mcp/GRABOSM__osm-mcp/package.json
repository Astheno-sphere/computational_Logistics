{
  "name": "osm-mcp",
  "version": "1.0.0",
  "description": "A MCP server build by Grab,  providing OpenStreetMap integration and location services with Nominatim, Overpass, OSRM, OSMOSE, and Taginfo APIs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http-server.d.ts",
      "import": "./dist/http-server.js",
      "default": "./dist/http-server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "osm-mcp": "./dist/index.js",
    "osm-mcp-http": "./dist/http-server-start.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples/"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npx tsc",
    "build:production": "npm run clean && npm run build",
    "clean": "rm -rf dist/",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server-start.js",
    "dev": "npx tsx src/index.ts",
    "dev:http": "npx tsx src/http-server-start.ts",
    "test": "npx jest",
    "test:coverage": "npx jest --coverage",
    "lint": "npx eslint src/**/*.ts",
    "lint:fix": "npx eslint src/**/*.ts --fix",
    "format": "npx prettier --write src/**/*.ts",
    "format:check": "npx prettier --check src/**/*.ts",
    "prepublishOnly": "npm run build:production && npm run test && npm run lint",
    "prepack": "npm run build:production",
    "postpack": "echo 'Package created successfully!'",
    "version": "npm run build:production && git add -A dist",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openstreetmap",
    "osm",
    "location",
    "mapping",
    "geocoding",
    "routing",
    "gis",
    "nominatim",
    "overpass",
    "osrm",
    "osmose",
    "taginfo",
    "spatial",
    "geography",
    "navigation",
    "poi",
    "geospatial",
    "plugin",
    "api",
    "rest",
    "server",
    "claude",
    "cursor",
    "ai",
    "assistant"
  ],
  "author": {
    "name": "Saikat Maiti",
    "url": "https://github.com/mapdevsaikat"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GRABOSM/osm-mcp.git"
  },
  "homepage": "https://github.com/GRABOSM/osm-mcp#readme",
  "bugs": {
    "url": "https://github.com/GRABOSM/osm-mcp/issues",
    "email": "geo.community@grabtaxi.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "redis": "^4.6.8",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "node": ">=20.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "publishConfig": {
    "access": "public"
  }
}