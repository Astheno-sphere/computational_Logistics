# OpenStreetMap MCP Server Configuration Template
# Copy this file to .env and customize for your deployment

# ======================================
# BASIC CONFIGURATION
# ======================================

# Server mode: 'self-hosted' or 'hosted-service'
NODE_ENV=production

# Server ports
PORT=8888
ADMIN_PORT=3002

# Logging
LOG_LEVEL=info

# CORS settings
CORS_ORIGIN=*

# ======================================
# AUTHENTICATION & AUTHORIZATION
# ======================================

# Enable authentication (false for self-hosted, true for hosted service)
ENABLE_AUTH=false

# JWT secret for token signing (required if ENABLE_AUTH=true)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ======================================
# RATE LIMITING
# ======================================

# Enable rate limiting (false for self-hosted, true for hosted service)
RATE_LIMIT_ENABLED=false

# ======================================
# DATABASE CONFIGURATION
# ======================================

# PostgreSQL connection (required for hosted service mode)
DATABASE_URL=postgresql://osmuser:osmpass@postgres:5432/osmmcp
POSTGRES_DB=osmmcp
POSTGRES_USER=osmuser
POSTGRES_PASSWORD=osmpass
POSTGRES_PORT=5432

# ======================================
# REDIS CONFIGURATION
# ======================================

# Redis connection (required for rate limiting)
REDIS_URL=redis://:redispass@redis:6379
REDIS_PASSWORD=redispass
REDIS_PORT=6379 