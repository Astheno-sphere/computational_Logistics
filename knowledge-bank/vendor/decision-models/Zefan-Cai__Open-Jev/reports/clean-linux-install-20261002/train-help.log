usage: open-jev-train [-h] --model MODEL --revision REVISION --data DATA
                      --output OUTPUT [--steps STEPS]
                      [--train-rows TRAIN_ROWS]
                      [--calibration-rows CALIBRATION_ROWS]
                      [--eval-rows EVAL_ROWS] [--max-length MAX_LENGTH]
                      [--lora-rank LORA_RANK] [--accumulation ACCUMULATION]
                      [--lr LR] [--head-lr HEAD_LR]
                      [--brier-weight BRIER_WEIGHT] [--seed SEED]
                      [--training-sampling {source_kind_round_robin,shuffled}]
                      [--checkpoint-every CHECKPOINT_EVERY]
                      [--resume-training RESUME_TRAINING]

options:
  -h, --help            show this help message and exit
  --model MODEL
  --revision REVISION
  --data DATA
  --output OUTPUT
  --steps STEPS
  --train-rows TRAIN_ROWS
  --calibration-rows CALIBRATION_ROWS
  --eval-rows EVAL_ROWS
  --max-length MAX_LENGTH
  --lora-rank LORA_RANK
  --accumulation ACCUMULATION
  --lr LR
  --head-lr HEAD_LR
  --brier-weight BRIER_WEIGHT
  --seed SEED
  --training-sampling {source_kind_round_robin,shuffled}
                        Use shuffled for a full pass without a source-sorted
                        tail
  --checkpoint-every CHECKPOINT_EVERY
                        Save resumable state every N completed optimizer
                        steps; zero disables
  --resume-training RESUME_TRAINING
                        Resume from a training-checkpoints/step-* directory
                        with matching run identity
