{
  "name": "qa-probe",
  "version": "2.12.1",
  "description": "Local QA agent — maps frontend routes to backend API calls, probes every endpoint live, scores pages 0–100, explains why data is missing. Works with any FastAPI/Express/Next.js app.",
  "license": "Apache-2.0",
  "author": "LS-SIEM LLP",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "qa-probe": "./bin/qa-probe.js"
  },
  "main": "./src/index.js",
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/qa-probe.js",
    "test": "node --test"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@faker-js/faker": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "chalk": "~4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "eventsource": "^2.0.2",
    "ora": "^5.4.1",
    "ws": "^8.16.0",
    "zod": "^3.22.0"
  },
  "keywords": [
    "qa",
    "api-testing",
    "openapi",
    "fastapi",
    "express",
    "nextjs",
    "frontend",
    "ast",
    "mcp",
    "devtools",
    "root-cause",
    "smoke-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LS-SIEM-LLP/qa-probe.git"
  },
  "bugs": {
    "url": "https://github.com/LS-SIEM-LLP/qa-probe/issues"
  },
  "homepage": "https://github.com/LS-SIEM-LLP/qa-probe#readme",
  "optionalDependencies": {
    "playwright": "^1.59.1"
  }
}
