# Minimal DaedalMap GitHub/local setup
#
# Copy this file to `.env` and point DATA_ROOT at your local data tree. No S3,
# R2, AWS, database, account, hosted-control-plane, or model API configuration
# is required for local data operations.

DEPLOYMENT=local
INSTALL_MODE=local
RUNTIME_MODE=local
PORT=7000

# Use an explicit local data tree. Leave blank only if you want DaedalMap's
# default per-user app-data location.
DATA_ROOT=C:/path/to/your/data

# Optional: set ONE provider key only for the built-in local chat UI.
# Researchers using the hosted Research MCP from an MCP-capable subscription
# client do not need either key here.
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: enables Google-backed browser map services when your setup uses
# them. Data queries and local pack storage do not depend on this key.
# GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Hosted MCP process-survival controls. Defaults are active when omitted.
# They are global per process and intentionally sit below caller entitlements.
# MCP_ADMISSION_ENABLED=true
# MCP_PUBLIC_MODE=open  # open | discovery_only | disabled
# MCP_ADMISSION_BURST_REQUESTS=30
# MCP_ADMISSION_BURST_WINDOW_SECONDS=10
# MCP_ADMISSION_REQUESTS_PER_MINUTE=120
# MCP_ADMISSION_MAX_CONCURRENCY=8
# MCP_MAX_REQUEST_BODY_BYTES=262144
# MCP_REQUEST_BODY_READ_TIMEOUT_SECONDS=10
# Synchronous MCP data/geometry work runs in this separate bounded lane. A
# timed-out worker keeps its slot until it really exits, preventing retry piles.
# MCP_EXECUTION_MAX_WORKERS=2
# MCP_EXECUTION_TIMEOUT_SECONDS=20

# Immutable artifact hydration will not unlink a recently returned local path.
# If the disk quota cannot be met without touching a recent path, that read
# falls back to the authoritative object-store URI instead.
# PUBLISHED_ARTIFACT_CACHE_EVICTION_GRACE_SECONDS=120
# Keep large parquet inputs remote for selective DuckDB/httpfs range reads.
# Small catalogs and hot metadata remain eligible for local hydration.
# PUBLISHED_ARTIFACT_CACHE_QUERY_MAX_FILE_MB=32
# Broad wildfire union warming is opt-in; keep startup/readiness bounded.
# PREWARM_WILDFIRES=0
# Broad disaster overlay warming is also opt-in after startup.
# PREWARM_DISASTERS=0
