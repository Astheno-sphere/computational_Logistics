# Bamwor MCP Server — Environment Variables
# Copy to .env and fill in your values

# OPTIONAL: Your Bamwor API key. The server works anonymously without it;
# a key unlocks full access and higher rate limits (register free at
# https://bamwor.com/en/developers/quickstart)
BAMWOR_API_KEY=bw_live_your_key_here

# OPTIONAL: Override API base URL (default: https://bamwor.com/api/v1)
# BAMWOR_API_URL=https://bamwor.com/api/v1
