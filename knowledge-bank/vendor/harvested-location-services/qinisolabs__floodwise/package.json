{
  "name": "floodwise",
  "version": "0.1.1",
  "mcpName": "io.github.qinisolabs/floodwise",
  "description": "Verified England flood-risk-by-postcode lookups for AI agents — official Environment Agency data, not guesses.",
  "license": "Apache-2.0",
  "author": "Qiniso",
  "homepage": "https://github.com/qinisolabs/floodwise#readme",
  "repository": { "type": "git", "url": "git+https://github.com/qinisolabs/floodwise.git" },
  "bugs": { "url": "https://github.com/qinisolabs/floodwise/issues" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "floodwise-mcp": "dist/server.js" },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=18" },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "llm",
    "flood-risk",
    "flooding",
    "postcode",
    "england",
    "environment-agency",
    "insurance"
  ],
  "scripts": {
    "gen": "node scripts/gen-data.mjs",
    "build": "npm run gen && tsc",
    "start": "node dist/server.js",
    "test": "npm run gen && tsx test/parity.test.ts",
    "deploy": "wrangler deploy",
    "build-data": "node scripts/build-data.mjs",
    "build-mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "@types/node": "^20.14.0"
  }
}
