# Greeks / Aetherfy API key (grk_<48 hex>). Create one at POST /api/auth/keys.
GREEKS_API_KEY=grk_your_key_here

# Base URL of the API. Defaults to the public API when unset.
# For local dev against `go run main.go`, use http://localhost:8080
# GREEKS_BASE_URL=https://api.greeks.pro

# Per-request timeout in seconds (default 30). Raise for expiration=all on heavy names.
# GREEKS_TIMEOUT=30

# Transport: stdio (default, what MCP clients spawn) or http.
# MCP_TRANSPORT=stdio
