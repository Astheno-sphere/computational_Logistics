{
  "name": "@apogeoapi/mcp",
  "version": "1.1.0",
  "description": "MCP server for ApogeoAPI — geographic data, live exchange rates & IP geolocation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apogeoapi-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node test/e2e.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "geolocation",
    "geography",
    "currency",
    "ip-geo",
    "apogeoapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/APOGEOAPI/apogeoapi-mcp.git"
  },
  "homepage": "https://apogeoapi.com",
  "mcpName": "com.apogeoapi/apogeoapi-mcp"
}
