{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.apogeoapi/apogeoapi-mcp",
  "description": "Geographic data API: 250+ countries, 150K+ cities, IP geolocation, 196 live FX rates.",
  "repository": {
    "url": "https://github.com/APOGEOAPI/apogeoapi-mcp",
    "source": "github"
  },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@apogeoapi/mcp",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-y",
          "description": "Auto-approve npx prompt",
          "isRequired": true
        },
        {
          "type": "positional",
          "value": "@apogeoapi/mcp",
          "description": "Package name",
          "isRequired": true
        }
      ],
      "environmentVariables": [
        {
          "name": "APOGEOAPI_KEY",
          "description": "API key from https://app.apogeoapi.com \u2014 free: 1,000 req/mo",
          "required": true
        }
      ]
    }
  ]
}
