[Unit]
Description=FilmMap MCP server (read-only Model Context Protocol endpoint over atlas-compact.json)
Documentation=https://thefilmmap.com/data/
After=network.target

[Service]
# __NODE__ is substituted with the detected node path by setup-filmmap-mcp.sh
ExecStart=__NODE__ /opt/filmmap-mcp/server.mjs
Environment=PORT=8896
Environment=HOST=127.0.0.1
Environment=ATLAS_JSON=/var/www/screenatlas/data/atlas-compact.json
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/var/www/screenatlas
RestrictAddressFamilies=AF_INET AF_INET6
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
