{
  "name": "atlasfetch-mcp",
  "version": "0.1.6",
  "mcpName": "xyz.atlasfetch/atlasfetch",
  "description": "MCP server for AtlasFetch — reverse geocode a coordinate to its country, region and municipality (ISO 3166 codes), the nearest street and house number, and match it against your own geofences.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "reverse-geocoding",
    "geocoding",
    "geofencing",
    "point-in-polygon",
    "administrative-boundaries",
    "iso-3166",
    "geojson",
    "gis",
    "street",
    "address"
  ],
  "license": "MIT",
  "author": "ATLASIQ PTY LTD",
  "homepage": "https://atlasfetch.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlasfetch-dev/atlasfetch-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/atlasfetch-dev/atlasfetch-mcp/issues"
  },
  "type": "module",
  "bin": {
    "atlasfetch-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^24.0.0",
    "fflate": "0.8.3",
    "typescript": "^5.9.0"
  }
}
