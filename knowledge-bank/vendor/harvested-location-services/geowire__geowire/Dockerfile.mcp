# syntax=docker/dockerfile:1
#
# MCP stdio 서버 전용 이미지.
# 루트 `Dockerfile`은 REST 서버(포트 4980)를 띄우는 반면, 이 이미지는 **stdio로 MCP
# 프로토콜을 말하는** `@geowirehq/mcp`를 실행한다 — MCP 클라이언트/디렉터리(Glama 등)가
# 컨테이너를 띄워 `tools/list` introspection을 할 수 있어야 하기 때문.
#
#   docker build -f Dockerfile.mcp -t geowire-mcp .
#   docker run -i --rm geowire-mcp        # -i 필수(stdio)
#
# 공급자 키는 환경변수로 주입한다(전부 선택 — 없으면 OSM/OSRM만으로 동작):
#   -e GOOGLE_MAPS_API_KEY=... -e YELP_API_KEY=... -e CENSUS_API_KEY=...

# ── builder: 워크스페이스 설치·빌드 후 mcp만 배포 번들로 추출 ──
FROM node:22-slim AS builder
WORKDIR /repo

RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

# 의존성 캐시 레이어: 매니페스트 먼저 복사
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

RUN pnpm build

# mcp 패키지 + prod 의존성(workspace provider들 포함)을 /app에 실복사 번들로 추출
# --legacy: pnpm v10에서 non-injected 워크스페이스를 배포하려면 필요
RUN pnpm --filter @geowirehq/mcp deploy --prod --legacy /app

# ── runner: distroless nodejs (shell 없음, 경량·비루트) ──
FROM gcr.io/distroless/nodejs22-debian12 AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app /app

USER nonroot

# distroless nodejs 이미지의 ENTRYPOINT는 node — stdio MCP 진입점만 넘긴다
CMD ["dist/bin.js"]
