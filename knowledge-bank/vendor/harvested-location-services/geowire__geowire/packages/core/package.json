{
  "name": "@geowirehq/core",
  "version": "0.6.2",
  "description": "GeoWire core — multi-provider geo pipeline: search, directions, isochrones, area analysis, merge/dedup, cost budgets, policy engine",
  "keywords": [
    "geocoding",
    "places",
    "maps",
    "directions",
    "isochrone",
    "demographics",
    "openstreetmap",
    "geospatial",
    "location-intelligence",
    "sdk"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@geowirehq/schema": "workspace:*",
    "@geowirehq/provider-sdk": "workspace:*",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@geowirehq/provider-nominatim": "workspace:*",
    "@geowirehq/provider-google": "workspace:*",
    "@geowirehq/provider-internal": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
