# IDE / VCS / 本地 Claude 配置（勿发布）
.vscode/**
.vscode-test/**
.git/**
.claude/**
.codex/**
.agentsociety/**
papers/**
datasets/**
user_data/**

# 源码与类型定义（发布 out/）
src/**
**/*.ts
**/*.map
**/tsconfig.json

# README / long walkthrough demos are hosted from the public GitHub mirror.
# Keep them in git for Marketplace links, but do not duplicate them inside VSIX.
resources/readme/**
resources/walkthrough/images/gif/init-0*.gif

# 工具链与本地配置（不进入 VSIX）
.gitignore
.editorconfig
.yarnrc
.npmrc
.prettierrc
vsc-extension-quickstart.md
**/.eslintrc.json
.eslintrc.json
eslint.config.mjs
webpack.config.js
package-lock.json
DEVELOPMENT.md
TODO.md
DEBUG_STEPS.md

# 开发/调试脚本与单元测试（勿打进 VSIX）
test/**
test-*.js
__vscode_mock.js
scripts/**
docs/**
.nvmrc

# 构建产物中的测试与 source map
out/test/**
out/**/*.map

# 运行期杂项
.env
*.log
.DS_Store
*.vsix
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/__pycache__
**/__pycache__/**

# 主扩展进程运行时依赖；其余依赖由 webview bundle 内联或仅开发期使用
node_modules/**
!node_modules/js-yaml/
!node_modules/js-yaml/index.js
!node_modules/js-yaml/package.json
!node_modules/js-yaml/lib/
!node_modules/js-yaml/lib/**
!node_modules/smol-toml/
!node_modules/smol-toml/**
!node_modules/write-file-atomic/
!node_modules/write-file-atomic/**
!node_modules/signal-exit/
!node_modules/signal-exit/**
# gatewayOutboundProxy → https-proxy-agent / socks-proxy-agent（及传递依赖）
!node_modules/https-proxy-agent/
!node_modules/https-proxy-agent/**
!node_modules/socks-proxy-agent/
!node_modules/socks-proxy-agent/**
!node_modules/agent-base/
!node_modules/agent-base/**
!node_modules/debug/
!node_modules/debug/**
!node_modules/ms/
!node_modules/ms/**
!node_modules/socks/
!node_modules/socks/**
!node_modules/smart-buffer/
!node_modules/smart-buffer/**
!node_modules/ip-address/
!node_modules/ip-address/**
